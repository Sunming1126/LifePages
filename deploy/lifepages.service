[Unit]
Description=LifePages private memoir API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lifepages
Group=lifepages
EnvironmentFile=/opt/lifepages/shared/lifepages.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/lifepages/current
ExecStart=/opt/lifepages/shared/venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8041 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/lifepages/shared/data
UMask=0077

[Install]
WantedBy=multi-user.target
