[Unit]
Description=LifePages private vector index
After=network.target

[Service]
User=lifepages
Group=lifepages
EnvironmentFile=/opt/lifepages/shared/qdrant.env
Environment=QDRANT__TELEMETRY_DISABLED=true
Environment=QDRANT__SERVICE__HOST=127.0.0.1
Environment=QDRANT__SERVICE__HTTP_PORT=6333
Environment=QDRANT__STORAGE__STORAGE_PATH=/opt/lifepages/shared/qdrant-data
Environment=QDRANT__STORAGE__PERFORMANCE__MAX_SEARCH_THREADS=2
WorkingDirectory=/opt/lifepages/shared/qdrant-data
ExecStart=/opt/lifepages/current/bin/qdrant --config-path /opt/lifepages/current/deploy/lifepages-qdrant.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/lifepages/shared/qdrant-data
MemoryHigh=160M
MemoryMax=288M
CPUQuota=100%
UMask=0077

[Install]
WantedBy=multi-user.target
